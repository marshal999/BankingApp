<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">


    <changeSet id="create-account-table" author="hamzehzadeh">

        <createTable tableName="ACCOUNT">

            <column name="ID_" type="UUID">
                <constraints primaryKey="true" primaryKeyName="PK_ACCOUNT" nullable="false"/>
            </column>

            <column name="ACCOUNT_NUMBER_" type="VARCHAR(15)">
                <constraints nullable="false" unique="true" uniqueConstraintName="UK_ACCOUNT_NUMBER"/>
            </column>

            <column name="OWNER_SSN" type="VARCHAR(10)">
                <constraints nullable="false"/>
            </column>

            <column name="BALANCE_" type="NUMERIC">
                <constraints nullable="false"/>
            </column>

        </createTable>

        <rollback>
            <dropTable tableName="ACCOUNT"/>
        </rollback>
    </changeSet>

    <changeSet id="create-transaction-table" author="hamzehzadeh">

        <createTable tableName="TRANSACTION">

            <column name="ID_" type="UUID">
                <constraints primaryKey="true" primaryKeyName="PK_TRANSACTION" nullable="false"/>
            </column>

            <column name="IDEMPOTENCY_KEY_" type="VARCHAR(36)">
                <constraints nullable="false" unique="true" uniqueConstraintName="UK_TRANSACTION_IDEMPOTENCY_KEY"/>
            </column>

            <column name="TYPE_" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>

            <column name="SOURCE_ACCOUNT_ID_" type="UUID">
                <constraints nullable="false"/>
            </column>

            <column name="DESTINATION_ACCOUNT_ID_" type="UUID"/>

            <column name="AMOUNT_" type="NUMERIC">
                <constraints nullable="false"/>
            </column>

            <column name="TIMESTAMP_" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>

        </createTable>

        <addForeignKeyConstraint
                baseTableName="TRANSACTION"
                baseColumnNames="SOURCE_ACCOUNT_ID_"
                constraintName="FK_TRANSACTION_SOURCE_ACCOUNT"
                referencedTableName="ACCOUNT"
                referencedColumnNames="ID_"/>

        <addForeignKeyConstraint
                baseTableName="TRANSACTION"
                baseColumnNames="DESTINATION_ACCOUNT_ID_"
                constraintName="FK_TRANSACTION_DESTINATION_ACCOUNT"
                referencedTableName="ACCOUNT"
                referencedColumnNames="ID_"/>

        <createIndex tableName="TRANSACTION"
                     indexName="IDX_TRANSACTION_SOURCE_ACCOUNT">
            <column name="SOURCE_ACCOUNT_ID_"/>
        </createIndex>

        <createIndex tableName="TRANSACTION"
                     indexName="IDX_TRANSACTION_DESTINATION_ACCOUNT">
            <column name="DESTINATION_ACCOUNT_ID_"/>
        </createIndex>

        <rollback>
            <dropTable tableName="TRANSACTION"/>
        </rollback>

    </changeSet>

    <changeSet id="add-status-to-transaction-table" author="hamzehzadeh">

        <addColumn tableName="TRANSACTION">
            <column name="STATUS_" type="VARCHAR(255)" defaultValue="COMPLETED">
                <constraints nullable="false"/>
            </column>
        </addColumn>

        <addDefaultValue
                tableName="TRANSACTION" columnName="STATUS_" defaultValue="PENDING" columnDataType="VARCHAR(255)"/>
    </changeSet>

</databaseChangeLog>